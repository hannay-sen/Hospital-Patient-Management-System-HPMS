flowchart TD
    subgraph NL["Nurse"]
        S((" ")) --> In["Select admitted patient"]
    end
    subgraph SL["System"]
        A{"Active admission exists?"}
        E1["Show: patient is not admitted"]
        Cl["Close admission with discharged_at = now"]
        Rl["Set room to AVAILABLE"]
        Sv1["Save admission and room together"]
        Calc["Base = daily rate x billable days + treatment charges"]
        Ap["Apply pricing rule to get final amount"]
        Sv2["Save bill with status UNPAID"]
        Pv{"0 < amount <= balance?"}
        E2["Reject payment. Balance unchanged"]
        Up["Reduce balance. Status PARTIALLY_PAID or PAID"]
        Sv3["Save bill"]
    end
    subgraph RL["Receptionist"]
        Gen["Generate inpatient bill"]
        Tc["Add treatment charges"]
        Pr["Choose Standard or Senior pricing"]
        Show["Review bill"]
        Pay{"Record a payment now?"}
        Amt["Enter amount"]
        X(((" ")))
    end
    In --> A
    A -- No --> E1 --> X
    A -- Yes --> Cl --> Rl --> Sv1 --> Gen
    Gen --> Tc --> Pr --> Calc --> Ap --> Sv2 --> Show --> Pay
    Pay -- No --> X
    Pay -- Yes --> Amt --> Pv
    Pv -- No --> E2 --> Amt
    Pv -- Yes --> Up --> Sv3 --> X
