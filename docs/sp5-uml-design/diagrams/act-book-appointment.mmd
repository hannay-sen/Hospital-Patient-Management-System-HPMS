---
config:
  layout: elk
---
flowchart TD
    S((" ")) --> In["Receptionist enters patient ID, doctor ID, date and hour"]
    In --> P{"Patient registered?"}
    P -- No --> E1["Show: patient is not registered"] --> X
    P -- Yes --> D{"ID belongs to a Doctor?"}
    D -- No --> E2["Show: doctor not found"] --> X
    D -- Yes --> V{"Valid date and on-the-hour time?"}
    V -- No --> E3["Show: invalid date or time"] --> X
    V -- Yes --> C{"Doctor has a Scheduled appointment in this slot?"}
    C -- Yes --> F["Find the doctor's free slots that day"] --> FS["Show free slots"]
    FS --> Again{"Pick another slot?"}
    Again -- Yes --> V
    Again -- No --> X
    C -- No --> PC{"Patient has a Scheduled appointment in this slot?"}
    PC -- Yes --> E4["Show: patient already booked then"] --> X
    PC -- No --> Cr["Create appointment with status Scheduled"]
    Cr --> Sv["Save JSON snapshot"]
    Sv --> OK{"Save succeeded?"}
    OK -- No --> E5["Show save error, keep last good data"] --> X
    OK -- Yes --> Conf["Show confirmation"] --> X(((" ")))
