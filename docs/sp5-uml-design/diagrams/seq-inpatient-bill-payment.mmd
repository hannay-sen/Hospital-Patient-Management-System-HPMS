sequenceDiagram
    actor R as Receptionist
    participant M as ReceptionistMenu
    participant S as BillingService
    participant H as Hospital
    participant B as InpatientBill
    participant P as PricingStrategy
    participant J as JsonRepository
    R->>M: Generate Inpatient Bill (admission ID, treatment charges, pricing rule)
    M->>S: generate_inpatient_bill(admission_id, charges, pricing_type)
    S->>H: find_admission(admission_id)
    H-->>S: Admission or None
    alt not found or still active
        S-->>M: error "Patient must be discharged first"
    else discharged
        S->>S: pricing = StandardPricing or SeniorDiscountPricing
        S->>B: create(admission, room daily_rate, pricing)
        loop each treatment charge
            S->>B: add_treatment_charge(description, amount)
        end
        S->>B: finalize(patient, today)
        B->>B: calculate_base_charge() = daily_rate x billable_days() + charges
        B->>P: apply(base, patient, today)
        P-->>B: final amount
        Note right of B: balance = final amount, status = UNPAID
        S->>H: add(bill)
        S->>J: save(hospital)
        J-->>S: committed
        S-->>M: bill
        M-->>R: show itemized bill and balance
    end
    opt receptionist records a payment
        R->>M: Record Payment (bill ID, amount)
        M->>S: record_payment(bill_id, amount)
        S->>H: find_bill(bill_id)
        H-->>S: InpatientBill
        S->>B: add_payment(amount)
        alt amount <= 0 or amount > balance (BR-07)
            B-->>S: ValueError, balance unchanged
            S-->>M: error
        else valid amount
            B->>B: reduce balance, status = PARTIALLY_PAID or PAID
            S->>J: save(hospital)
            J-->>S: committed
            S-->>M: new balance
        end
        M-->>R: updated balance or error
    end
