digraph UCD {
  rankdir=LR; nodesep=0.12; ranksep=1.1; ordering=out; splines=true;
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=none];
  node [shape=none, image="actor.png", imagescale=false, labelloc=b, height=1.5, width=1.2, fixedsize=true];
  Receptionist; Doctor; Nurse; Administrator;
  {rank=same; Receptionist -> Doctor -> Nurse -> Administrator [style=invis];}
  node [shape=ellipse, image="", style=filled, fillcolor="#eef3fa", color="#4a6f9b", height=0.38, width=3.6, fixedsize=true, labelloc=c];
  subgraph cluster_sys {
    label="Hospital Patient Management System"; fontname="Helvetica-Bold"; fontsize=13; color="#4a6f9b"; style=rounded; margin=14;
    RegP [label="Register Patient (UC1)"]; SrchP [label="Search Patient (UC1)"]; UpdP [label="Update Patient (UC1)"];
    Book [label="Book Appointment (UC2)"]; Cancel [label="Cancel Appointment (UC3)"]; Resch [label="Reschedule Appointment (UC3)"];
    OutBill [label="Generate Outpatient Bill (UC6)"]; InBill [label="Generate Inpatient Bill (UC6)"]; Pay [label="Record Payment (UC6)"];
    ViewAp [label="View Assigned Appointments (UC4)"]; Comp [label="Mark Appointment Completed (UC4)"];
    Diag [label="Record Diagnosis (UC4)"]; Presc [label="Write Prescription (UC4)"]; Hist [label="View Medical History (UC4, UC5)"];
    Admit [label="Admit Patient (UC5)"]; Disch [label="Discharge Patient (UC5)"]; RoomSt [label="Update Room Status (UC5)"];
    Staff [label="Create Staff (UC7)"]; EditStaff [label="Update or Remove Staff (UC7)"]; DeptRoom [label="Manage Departments and Rooms (UC7)"];
    Rep8 [label="View Billing and Occupancy Reports (UC8)"]; Rep9 [label="View Scheduling Reports (UC9)"];
    node [fillcolor="#fff8e6", color="#b08a2e", width=2.4];
    Slots [label="Show Available Slots"]; Check [label="Check Doctor Availability"]; Price [label="Apply Pricing Rule"];
  }
  Receptionist -> RegP; Receptionist -> SrchP; Receptionist -> UpdP; Receptionist -> Book; Receptionist -> Cancel; Receptionist -> Resch; Receptionist -> OutBill; Receptionist -> InBill; Receptionist -> Pay;
  Doctor -> ViewAp; Doctor -> Comp; Doctor -> Diag; Doctor -> Presc; Doctor -> Hist;
  Nurse -> Hist; Nurse -> Admit; Nurse -> Disch; Nurse -> RoomSt;
  Administrator -> Staff; Administrator -> EditStaff; Administrator -> DeptRoom; Administrator -> Rep8; Administrator -> Rep9;
  edge [style=dashed, arrowhead=vee];
  Book -> Slots [dir=back, xlabel="«extend»"];
  Book -> Check [xlabel="«include»"]; Resch -> Check [xlabel="«include»"];
  OutBill -> Price [xlabel="«include»"]; InBill -> Price [xlabel="«include»"];
}
