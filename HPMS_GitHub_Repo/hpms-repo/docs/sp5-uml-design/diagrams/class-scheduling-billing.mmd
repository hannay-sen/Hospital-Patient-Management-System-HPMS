---
config:
  layout: elk
---
classDiagram
    direction TB
    class Appointment {
        -appointment_id: str
        -patient_id: str
        -doctor_id: str
        -slot: datetime
        -status: AppointmentStatus
        +cancel() None
        +complete() None
        +blocks_slot() bool
    }
    class AppointmentStatus {
        <<enumeration>>
        SCHEDULED
        COMPLETED
        CANCELLED
    }
    class Room {
        -room_number: str
        -room_type: str
        -daily_rate: Decimal
        -status: RoomStatus
        +is_available() bool
        +occupy() None
        +release() None
        +set_maintenance(on: bool) None
    }
    class RoomStatus {
        <<enumeration>>
        AVAILABLE
        OCCUPIED
        MAINTENANCE
    }
    class Admission {
        -admission_id: str
        -patient_id: str
        -room_number: str
        -admitted_at: datetime
        -discharged_at: Optional~datetime~
        +is_active() bool
        +close(discharged_at: datetime) None
        +billable_days() int
    }
    class Bill {
        <<abstract>>
        -bill_id: str
        -patient_id: str
        -pricing: PricingStrategy
        -final_amount: Decimal
        -_balance: Decimal
        -payments: list~Payment~
        -status: BillStatus
        +calculate_base_charge()* Decimal
        +finalize(patient: Patient, on_date: date) None
        +add_payment(amount: Decimal) None
        +get_balance() Decimal
    }
    class OutpatientBill {
        -appointment_id: Optional~str~
        -consultation_fee: Decimal
        +calculate_base_charge() Decimal
    }
    class InpatientBill {
        -admission: Admission
        -daily_rate: Decimal
        -treatment_charges: list~TreatmentCharge~
        +add_treatment_charge(description: str, amount: Decimal) None
        +calculate_base_charge() Decimal
    }
    class TreatmentCharge {
        -description: str
        -amount: Decimal
    }
    class Payment {
        -amount: Decimal
        -paid_at: datetime
    }
    class BillStatus {
        <<enumeration>>
        DRAFT
        UNPAID
        PARTIALLY_PAID
        PAID
    }
    class PricingStrategy {
        <<abstract>>
        +apply(amount: Decimal, patient: Patient, on_date: date)* Decimal
    }
    class StandardPricing {
        +apply(amount: Decimal, patient: Patient, on_date: date) Decimal
    }
    class SeniorDiscountPricing {
        -AGE_THRESHOLD: int = 65
        -DISCOUNT_RATE: Decimal = 0.10
        +apply(amount: Decimal, patient: Patient, on_date: date) Decimal
    }

    Appointment ..> AppointmentStatus
    Room ..> RoomStatus
    Admission "*" --> "1" Room : uses
    Bill <|-- OutpatientBill
    Bill <|-- InpatientBill
    Bill "1" *-- "*" Payment
    Bill ..> BillStatus
    Bill "*" --> "1" PricingStrategy : priced by
    OutpatientBill "0..1" --> "1" Appointment : for visit
    InpatientBill "0..1" --> "1" Admission : for stay
    InpatientBill "1" *-- "*" TreatmentCharge
    PricingStrategy <|.. StandardPricing
    PricingStrategy <|.. SeniorDiscountPricing
