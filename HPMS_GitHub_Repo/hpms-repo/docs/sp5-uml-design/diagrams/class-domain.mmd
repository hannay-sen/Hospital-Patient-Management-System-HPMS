---
config:
  layout: elk
---
classDiagram
    direction TB
    class Person { <<abstract>> }
    class Staff { <<abstract>> }
    class Bill { <<abstract>> }
    class PricingStrategy { <<abstract>> }

    Person <|-- Patient
    Person <|-- Staff
    Staff <|-- Doctor
    Staff <|-- Nurse
    Staff <|-- Receptionist

    Department "1" o-- "*" Staff : groups
    Patient "1" *-- "1" MedicalRecord : owns
    MedicalRecord "1" *-- "*" Diagnosis
    MedicalRecord "1" *-- "*" Prescription

    Appointment "*" --> "1" Patient : for
    Appointment "*" --> "1" Doctor : with
    Admission "*" --> "1" Patient : admits
    Admission "*" --> "1" Room : uses

    Bill <|-- OutpatientBill
    Bill <|-- InpatientBill
    Bill "*" --> "1" Patient : charged to
    Bill "1" *-- "*" Payment
    Bill "*" --> "1" PricingStrategy : priced by
    OutpatientBill "0..1" --> "1" Appointment : for visit
    InpatientBill "0..1" --> "1" Admission : for stay
    InpatientBill "1" *-- "*" TreatmentCharge
    PricingStrategy <|.. StandardPricing
    PricingStrategy <|.. SeniorDiscountPricing
